<UserControl x:Class="StokTakip.Wpf.Views.CategoryManagementView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="360" />
            <ColumnDefinition Width="16" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Border Style="{StaticResource CardBorderStyle}">
            <StackPanel>
                <TextBlock Text="Kategori Yönetimi" FontSize="22" FontWeight="Bold" Foreground="{StaticResource TextDarkBrush}" />
                <TextBlock Text="Ürün kategorilerini düzenli şekilde yönetin."
                           Margin="0,6,0,18"
                           Foreground="{StaticResource TextMutedBrush}" />

                <TextBlock Text="Kategori Adı" FontWeight="SemiBold" />
                <TextBox Margin="0,4,0,12" />

                <TextBlock Text="Açıklama" FontWeight="SemiBold" />
                <TextBox Margin="0,4,0,12" Height="90" TextWrapping="Wrap" AcceptsReturn="True" VerticalContentAlignment="Top" />

                <CheckBox Content="Aktif mi?" IsChecked="True" Margin="0,4,0,18" />

                <UniformGrid Columns="2">
                    <Button Content="Ekle" Margin="0,0,8,8" Style="{StaticResource PrimaryButtonStyle}" Click="BtnIslemIskeleti_Click" />
                    <Button Content="Güncelle" Margin="0,0,0,8" Style="{StaticResource SecondaryButtonStyle}" Click="BtnIslemIskeleti_Click" />
                    <Button Content="Sil" Margin="0,0,8,0" Style="{StaticResource SecondaryButtonStyle}" Click="BtnIslemIskeleti_Click" />
                    <Button Content="Temizle" Style="{StaticResource SecondaryButtonStyle}" Click="BtnIslemIskeleti_Click" />
                </UniformGrid>
            </StackPanel>
        </Border>

        <Border Grid.Column="2" Style="{StaticResource CardBorderStyle}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <TextBlock Text="Kategori Listesi" FontSize="22" FontWeight="Bold" Foreground="{StaticResource TextDarkBrush}" />
                <DataGrid Grid.Row="1"
                          Margin="0,16,0,0"
                          ItemsSource="{Binding Kategoriler}"
                          AutoGenerateColumns="False"
                          CanUserAddRows="False"
                          IsReadOnly="True">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="ID" Binding="{Binding Id}" Width="60" />
                        <DataGridTextColumn Header="Kategori Adı" Binding="{Binding KategoriAdi}" Width="180" />
                        <DataGridTextColumn Header="Açıklama" Binding="{Binding Aciklama}" Width="*" />
                        <DataGridCheckBoxColumn Header="Aktif" Binding="{Binding AktifMi}" Width="80" />
                        <DataGridTextColumn Header="Oluşturma Tarihi" Binding="{Binding OlusturmaTarihi}" Width="170" />
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>
        </Border>
    </Grid>
</UserControl>
