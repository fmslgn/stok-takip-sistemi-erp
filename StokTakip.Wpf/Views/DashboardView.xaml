<UserControl x:Class="StokTakip.Wpf.Views.DashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel>
            <Border Style="{StaticResource CardBorderStyle}">
                <StackPanel>
                    <TextBlock Text="Ana Menü"
                               FontSize="28"
                               FontWeight="Bold"
                               Foreground="{StaticResource TextDarkBrush}" />
                    <TextBlock Text="Stoklarını düzenle, işini kolaylaştır."
                               Margin="0,6,0,20"
                               FontSize="15"
                               Foreground="{StaticResource TextMutedBrush}" />

                    <UniformGrid Columns="4">
                        <Border Style="{StaticResource CardBorderStyle}" Margin="0,0,12,0" Padding="18">
                            <StackPanel>
                                <TextBlock Text="Toplam Ürün" Foreground="{StaticResource TextMutedBrush}" />
                                <TextBlock Text="{Binding ToplamUrun}" FontSize="30" FontWeight="Bold" Foreground="{StaticResource TextDarkBrush}" />
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource CardBorderStyle}" Margin="0,0,12,0" Padding="18">
                            <StackPanel>
                                <TextBlock Text="Kritik Stok" Foreground="{StaticResource TextMutedBrush}" />
                                <TextBlock Text="{Binding KritikStok}" FontSize="30" FontWeight="Bold" Foreground="{StaticResource DangerBrush}" />
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource CardBorderStyle}" Margin="0,0,12,0" Padding="18">
                            <StackPanel>
                                <TextBlock Text="Toplam Stok" Foreground="{StaticResource TextMutedBrush}" />
                                <TextBlock Text="{Binding ToplamStok}" FontSize="30" FontWeight="Bold" Foreground="{StaticResource TextDarkBrush}" />
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource CardBorderStyle}" Padding="18">
                            <StackPanel>
                                <TextBlock Text="Saklama Asistanı" Foreground="{StaticResource TextMutedBrush}" />
                                <TextBlock Text="{Binding SaklamaAsistaniDurumu}" FontSize="30" FontWeight="Bold" Foreground="{StaticResource PrimaryBrush}" />
                            </StackPanel>
                        </Border>
                    </UniformGrid>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource CardBorderStyle}" Margin="0,16,0,0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Margin="0,0,14,0">
                        <TextBlock Text="Hızlı Erişim"
                                   FontSize="20"
                                   FontWeight="Bold"
                                   Foreground="{StaticResource TextDarkBrush}" />
                        <TextBlock Text="Sol menüden ürün yönetimi ve raporlama ekranlarına geçiş yapabilirsiniz."
                                   Margin="0,8,0,0"
                                   TextWrapping="Wrap"
                                   Foreground="{StaticResource TextMutedBrush}" />
                    </StackPanel>

                    <StackPanel Grid.Column="1">
                        <TextBlock Text="WPF Arayüz Durumu"
                                   FontSize="20"
                                   FontWeight="Bold"
                                   Foreground="{StaticResource TextDarkBrush}" />
                        <TextBlock Text="Bu katman WinForms sürümünü koruyarak modern masaüstü ERP arayüzü için hazırlanmıştır."
                                   Margin="0,8,0,0"
                                   TextWrapping="Wrap"
                                   Foreground="{StaticResource TextMutedBrush}" />
                    </StackPanel>
                </Grid>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
