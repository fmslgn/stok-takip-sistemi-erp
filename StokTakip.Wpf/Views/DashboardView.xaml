<UserControl x:Class="StokTakip.Wpf.Views.DashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel>
            <ProgressBar Height="4"
                         Margin="0,0,0,8"
                         IsIndeterminate="True">
                <ProgressBar.Style>
                    <Style TargetType="ProgressBar">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsBusy}" Value="True">
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </ProgressBar.Style>
            </ProgressBar>
            <Border Style="{StaticResource CardBorderStyle}">
                <StackPanel>
                    <TextBlock Text="Ana Menü"
                               FontSize="26"
                               FontWeight="Bold"
                               Foreground="{DynamicResource TextDarkBrush}" />
                    <TextBlock Text="Stoklarını düzenle, işini kolaylaştır."
                               Margin="0,4,0,14"
                               FontSize="14"
                               Foreground="{DynamicResource TextMutedBrush}" />

                    <Grid MinHeight="112">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="8" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="8" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Border Grid.Column="0"
                                Style="{StaticResource CardBorderStyle}"
                                Padding="16"
                                VerticalAlignment="Stretch">
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="Toplam Ürün" FontSize="13" Foreground="{DynamicResource TextMutedBrush}" />
                                <TextBlock Margin="0,6,0,0"
                                           Text="{Binding ToplamUrun}"
                                           FontSize="28"
                                           FontWeight="Bold"
                                           Foreground="{DynamicResource TextDarkBrush}" />
                            </StackPanel>
                        </Border>
                        <Border Grid.Column="2"
                                Style="{StaticResource CardBorderStyle}"
                                Padding="16"
                                VerticalAlignment="Stretch">
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="Kritik Stok" FontSize="13" Foreground="{DynamicResource TextMutedBrush}" />
                                <TextBlock Margin="0,6,0,0"
                                           Text="{Binding KritikStok}"
                                           FontSize="28"
                                           FontWeight="Bold"
                                           Foreground="{DynamicResource DangerBrush}" />
                            </StackPanel>
                        </Border>
                        <Border Grid.Column="4"
                                Style="{StaticResource CardBorderStyle}"
                                Padding="16"
                                VerticalAlignment="Stretch">
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="Toplam Stok" FontSize="13" Foreground="{DynamicResource TextMutedBrush}" />
                                <TextBlock Margin="0,6,0,0"
                                           Text="{Binding ToplamStok}"
                                           FontSize="28"
                                           FontWeight="Bold"
                                           Foreground="{DynamicResource TextDarkBrush}" />
                            </StackPanel>
                        </Border>
                    </Grid>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource CardBorderStyle}" Margin="0,10,0,0">
                <StackPanel>
                    <TextBlock Text="Hızlı Erişim"
                               Style="{StaticResource SectionTitleTextStyle}"
                               FontSize="20" />
                    <TextBlock Margin="0,4,0,0"
                               TextWrapping="Wrap"
                               Foreground="{DynamicResource TextMutedBrush}"
                               FontSize="13"
                               Text="Sık kullanılan modüllere tek tıkla geçin; sol menü vurgusu güncellenir." />

                    <UniformGrid Columns="3" Margin="0,10,-6,-6">
                        <Button Style="{StaticResource DashboardQuickAccessCardButtonStyle}"
                                Click="HizliErisimUrun_Click">
                            <StackPanel>
                                <TextBlock Text="Ürün Yönetimi"
                                           FontSize="15"
                                           FontWeight="SemiBold"
                                           Foreground="{DynamicResource TextDarkBrush}" />
                                <TextBlock Margin="0,6,0,0"
                                           FontSize="12"
                                           TextWrapping="Wrap"
                                           Foreground="{DynamicResource TextMutedBrush}"
                                           Text="Ürün ekleme, güncelleme ve listeleme işlemleri." />
                            </StackPanel>
                        </Button>
                        <Button Style="{StaticResource DashboardQuickAccessCardButtonStyle}"
                                Click="HizliErisimKategori_Click">
                            <StackPanel>
                                <TextBlock Text="Kategori Yönetimi"
                                           FontSize="15"
                                           FontWeight="SemiBold"
                                           Foreground="{DynamicResource TextDarkBrush}" />
                                <TextBlock Margin="0,6,0,0"
                                           FontSize="12"
                                           TextWrapping="Wrap"
                                           Foreground="{DynamicResource TextMutedBrush}"
                                           Text="Ürün gruplarını düzenleyin ve takip edin." />
                            </StackPanel>
                        </Button>
                        <Button Style="{StaticResource DashboardQuickAccessCardButtonStyle}"
                                Click="HizliErisimStokGiris_Click">
                            <StackPanel>
                                <TextBlock Text="Stok Giriş"
                                           FontSize="15"
                                           FontWeight="SemiBold"
                                           Foreground="{DynamicResource TextDarkBrush}" />
                                <TextBlock Margin="0,6,0,0"
                                           FontSize="12"
                                           TextWrapping="Wrap"
                                           Foreground="{DynamicResource TextMutedBrush}"
                                           Text="Depoya yeni stok girişi yapın." />
                            </StackPanel>
                        </Button>
                        <Button Style="{StaticResource DashboardQuickAccessCardButtonStyle}"
                                Click="HizliErisimStokCikis_Click">
                            <StackPanel>
                                <TextBlock Text="Stok Çıkış"
                                           FontSize="15"
                                           FontWeight="SemiBold"
                                           Foreground="{DynamicResource TextDarkBrush}" />
                                <TextBlock Margin="0,6,0,0"
                                           FontSize="12"
                                           TextWrapping="Wrap"
                                           Foreground="{DynamicResource TextMutedBrush}"
                                           Text="Çıkış ve sevkiyat için stok düşürün." />
                            </StackPanel>
                        </Button>
                        <Button Style="{StaticResource DashboardQuickAccessCardButtonStyle}"
                                Click="HizliErisimKritik_Click">
                            <StackPanel>
                                <TextBlock Text="Kritik Stok"
                                           FontSize="15"
                                           FontWeight="SemiBold"
                                           Foreground="{DynamicResource TextDarkBrush}" />
                                <TextBlock Margin="0,6,0,0"
                                           FontSize="12"
                                           TextWrapping="Wrap"
                                           Foreground="{DynamicResource TextMutedBrush}"
                                           Text="Eşik altındaki ürünleri görüntüleyin." />
                            </StackPanel>
                        </Button>
                        <Button Style="{StaticResource DashboardQuickAccessCardButtonStyle}"
                                Click="HizliErisimRapor_Click">
                            <StackPanel>
                                <TextBlock Text="Raporlama"
                                           FontSize="15"
                                           FontWeight="SemiBold"
                                           Foreground="{DynamicResource TextDarkBrush}" />
                                <TextBlock Margin="0,6,0,0"
                                           FontSize="12"
                                           TextWrapping="Wrap"
                                           Foreground="{DynamicResource TextMutedBrush}"
                                           Text="Stok durumunu görsel raporlarla takip edin." />
                            </StackPanel>
                        </Button>
                    </UniformGrid>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
