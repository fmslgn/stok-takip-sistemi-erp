<Window x:Class="StokTakip.Wpf.Views.ProductListPreviewWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Ürün Listesi"
        Height="900"
        Width="1400"
        MinHeight="480"
        MinWidth="900"
        WindowStartupLocation="CenterOwner"
        WindowState="Maximized">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0"
                   Text="Ürün Listesi"
                   Style="{StaticResource SectionTitleTextStyle}" />

        <DataGrid x:Name="UrunGrid"
                  Grid.Row="1"
                  Margin="0,12,0,12"
                  HorizontalScrollBarVisibility="Auto"
                  VerticalScrollBarVisibility="Auto"
                  AutoGenerateColumns="False"
                  CanUserAddRows="False"
                  IsReadOnly="True"
                  HeadersVisibility="Column"
                  GridLinesVisibility="Horizontal">
            <DataGrid.Columns>
                <DataGridTextColumn Header="ID" Binding="{Binding Id}" Width="56" />
                <DataGridTextColumn Header="Ürün Adı" Binding="{Binding UrunAdi}" Width="220" />
                <DataGridTextColumn Header="Barkod" Binding="{Binding Barkod}" Width="120" />
                <DataGridTextColumn Header="Birim" Binding="{Binding Birim}" Width="72" />
                <DataGridTextColumn Header="Stok" Binding="{Binding StokMiktari}" Width="72" />
                <DataGridTextColumn Header="Kritik" Binding="{Binding KritikStokSeviyesi}" Width="80" />
                <DataGridTextColumn Header="Alış" Binding="{Binding AlisFiyati}" Width="96" />
                <DataGridTextColumn Header="Satış" Binding="{Binding SatisFiyati}" Width="96" />
                <DataGridCheckBoxColumn Header="Aktif" Binding="{Binding AktifMi}" Width="64" />
                <DataGridTextColumn Header="Açıklama" Binding="{Binding Aciklama}" Width="*" MinWidth="120" />
            </DataGrid.Columns>
        </DataGrid>

        <StackPanel Grid.Row="2"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right">
            <Button Content="PDF Kaydet"
                    Margin="0,0,10,0"
                    MinWidth="120"
                    Style="{StaticResource PrimaryButtonStyle}"
                    Click="BtnPdfKaydet_Click" />
            <Button Content="Kapat"
                    MinWidth="96"
                    Style="{StaticResource SecondaryButtonStyle}"
                    Click="BtnKapat_Click" />
        </StackPanel>
    </Grid>
</Window>
