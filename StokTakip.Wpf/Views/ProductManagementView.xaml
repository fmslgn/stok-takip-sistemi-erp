<UserControl x:Class="StokTakip.Wpf.Views.ProductManagementView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="0.45*" MinWidth="420" />
            <ColumnDefinition Width="16" />
            <ColumnDefinition Width="0.55*" MinWidth="520" />
        </Grid.ColumnDefinitions>

        <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <Border Style="{StaticResource CardBorderStyle}">
                    <StackPanel>
                        <TextBlock Text="Ürün Bilgi Formu"
                                   FontSize="22"
                                   FontWeight="Bold"
                                   Foreground="{StaticResource TextDarkBrush}" />

                        <Grid Margin="0,18,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="18" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <StackPanel Grid.Row="0" Grid.Column="0" Margin="0,0,0,14">
                                <TextBlock Text="Kategori" FontWeight="SemiBold" />
                                <ComboBox ItemsSource="{Binding Kategoriler}" DisplayMemberPath="KategoriAdi" />
                            </StackPanel>
                            <StackPanel Grid.Row="0" Grid.Column="2" Margin="0,0,0,14">
                                <TextBlock Text="Saklama Koşulu" FontWeight="SemiBold" />
                                <ComboBox ItemsSource="{Binding SaklamaKosullari}" DisplayMemberPath="KosulAdi" />
                            </StackPanel>

                            <StackPanel Grid.Row="1" Grid.Column="0" Margin="0,0,0,14">
                                <TextBlock Text="Ürün Adı" FontWeight="SemiBold" />
                                <TextBox />
                            </StackPanel>
                            <StackPanel Grid.Row="1" Grid.Column="2" Margin="0,0,0,14">
                                <TextBlock Text="Barkod" FontWeight="SemiBold" />
                                <TextBox />
                            </StackPanel>

                            <StackPanel Grid.Row="2" Grid.Column="0" Margin="0,0,0,14">
                                <TextBlock Text="Birim" FontWeight="SemiBold" />
                                <TextBox />
                            </StackPanel>
                            <StackPanel Grid.Row="2" Grid.Column="2" Margin="0,0,0,14">
                                <TextBlock Text="Açıklama" FontWeight="SemiBold" />
                                <TextBox />
                            </StackPanel>

                            <StackPanel Grid.Row="3" Grid.Column="0" Margin="0,0,0,14">
                                <TextBlock Text="Stok" FontWeight="SemiBold" />
                                <TextBox />
                            </StackPanel>
                            <StackPanel Grid.Row="3" Grid.Column="2" Margin="0,0,0,14">
                                <TextBlock Text="Kritik Stok" FontWeight="SemiBold" />
                                <TextBox />
                            </StackPanel>

                            <StackPanel Grid.Row="4" Grid.Column="0">
                                <TextBlock Text="Alış Fiyatı" FontWeight="SemiBold" />
                                <TextBox />
                            </StackPanel>
                            <StackPanel Grid.Row="4" Grid.Column="2">
                                <TextBlock Text="Satış Fiyatı" FontWeight="SemiBold" />
                                <TextBox />
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource CardBorderStyle}" Margin="0,16,0,0">
                    <StackPanel>
                        <TextBlock Text="Ürün İşlemleri"
                                   FontSize="22"
                                   FontWeight="Bold"
                                   Foreground="{StaticResource TextDarkBrush}" />
                        <CheckBox Content="Aktif ürün"
                                  Margin="0,14,0,14"
                                  IsChecked="True" />

                        <UniformGrid Columns="4">
                            <Button Content="Ekle" Margin="0,0,8,0" Style="{StaticResource PrimaryButtonStyle}" Click="BtnIslemIskeleti_Click" />
                            <Button Content="Güncelle" Margin="0,0,8,0" Style="{StaticResource SecondaryButtonStyle}" Click="BtnIslemIskeleti_Click" />
                            <Button Content="Sil" Margin="0,0,8,0" Style="{StaticResource SecondaryButtonStyle}" Click="BtnIslemIskeleti_Click" />
                            <Button Content="Temizle" Style="{StaticResource SecondaryButtonStyle}" Click="BtnIslemIskeleti_Click" />
                        </UniformGrid>

                        <Button Content="Saklama Asistanı"
                                Margin="0,16,0,0"
                                HorizontalAlignment="Left"
                                Style="{StaticResource PrimaryButtonStyle}"
                                Click="BtnSaklamaAsistani_Click" />
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <Border Grid.Column="2" Style="{StaticResource CardBorderStyle}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <TextBlock Text="Ürün Listesi"
                           FontSize="22"
                           FontWeight="Bold"
                           Foreground="{StaticResource TextDarkBrush}" />

                <Grid Grid.Row="1" Margin="0,18,0,14">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="14" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="14" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0">
                        <TextBlock Text="Kategori Filtresi" FontWeight="SemiBold" />
                        <ComboBox ItemsSource="{Binding Kategoriler}" DisplayMemberPath="KategoriAdi" />
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                        <TextBlock Text="Ürün Adı Filtresi" FontWeight="SemiBold" />
                        <TextBox />
                    </StackPanel>
                    <Button Grid.Column="4"
                            Content="Listele / Yenile"
                            VerticalAlignment="Bottom"
                            Style="{StaticResource PrimaryButtonStyle}"
                            Click="BtnListeYenile_Click" />
                </Grid>

                <DataGrid Grid.Row="2"
                          ItemsSource="{Binding Urunler}"
                          AutoGenerateColumns="False"
                          CanUserAddRows="False"
                          IsReadOnly="True"
                          HeadersVisibility="Column"
                          GridLinesVisibility="Horizontal">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="ID" Binding="{Binding Id}" Width="60" />
                        <DataGridTextColumn Header="Ürün Adı" Binding="{Binding UrunAdi}" Width="160" />
                        <DataGridTextColumn Header="Barkod" Binding="{Binding Barkod}" Width="150" />
                        <DataGridTextColumn Header="Birim" Binding="{Binding Birim}" Width="90" />
                        <DataGridTextColumn Header="Stok" Binding="{Binding StokMiktari}" Width="80" />
                        <DataGridTextColumn Header="Kritik Stok" Binding="{Binding KritikStokSeviyesi}" Width="100" />
                        <DataGridTextColumn Header="Alış Fiyatı" Binding="{Binding AlisFiyati}" Width="100" />
                        <DataGridTextColumn Header="Satış Fiyatı" Binding="{Binding SatisFiyati}" Width="100" />
                        <DataGridTextColumn Header="Açıklama" Binding="{Binding Aciklama}" Width="*" />
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>
        </Border>
    </Grid>
</UserControl>
