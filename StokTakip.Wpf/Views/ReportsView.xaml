<UserControl x:Class="StokTakip.Wpf.Views.ReportsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel>
            <Border Style="{StaticResource CardBorderStyle}" Margin="0,0,0,16">
                <StackPanel>
                    <TextBlock Text="Raporlama"
                               FontSize="24"
                               FontWeight="Bold"
                               Foreground="{StaticResource TextDarkBrush}" />
                    <TextBlock Text="Toplam ürün, kritik stok ve toplam stok bilgilerini takip edin."
                               Margin="0,6,0,0"
                               Foreground="{StaticResource TextMutedBrush}" />
                </StackPanel>
            </Border>

            <UniformGrid Columns="3">
                <Border Style="{StaticResource CardBorderStyle}" Margin="0,0,12,0">
                    <StackPanel>
                        <TextBlock Text="Toplam Ürün" Foreground="{StaticResource TextMutedBrush}" />
                        <TextBlock Text="{Binding ToplamUrun}" FontSize="32" FontWeight="Bold" Foreground="{StaticResource TextDarkBrush}" />
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource CardBorderStyle}" Margin="0,0,12,0">
                    <StackPanel>
                        <TextBlock Text="Kritik Stok" Foreground="{StaticResource TextMutedBrush}" />
                        <TextBlock Text="{Binding KritikStok}" FontSize="32" FontWeight="Bold" Foreground="{StaticResource DangerBrush}" />
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource CardBorderStyle}">
                    <StackPanel>
                        <TextBlock Text="Toplam Stok" Foreground="{StaticResource TextMutedBrush}" />
                        <TextBlock Text="{Binding ToplamStok}" FontSize="32" FontWeight="Bold" Foreground="{StaticResource TextDarkBrush}" />
                    </StackPanel>
                </Border>
            </UniformGrid>

            <Grid Margin="0,16,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="0.65*" />
                    <ColumnDefinition Width="16" />
                    <ColumnDefinition Width="0.35*" />
                </Grid.ColumnDefinitions>

                <Border Style="{StaticResource CardBorderStyle}">
                    <StackPanel>
                        <TextBlock Text="Görsel Rapor"
                                   FontSize="22"
                                   FontWeight="Bold"
                                   Foreground="{StaticResource TextDarkBrush}" />
                        <TextBlock Text="Stok durumunu ve kritik stok oranını görsel olarak takip edebilirsiniz."
                                   Margin="0,6,0,18"
                                   Foreground="{StaticResource TextMutedBrush}" />

                        <TextBlock Text="Kritik Stok Oranı" FontWeight="SemiBold" />
                        <Grid Margin="0,6,0,16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="90" />
                            </Grid.ColumnDefinitions>
                            <ProgressBar Minimum="0"
                                         Maximum="100"
                                         Height="16"
                                         Value="{Binding KritikStokOrani, Mode=OneWay}" />
                            <TextBlock Grid.Column="1"
                                       Text="{Binding KritikStokOraniMetni, Mode=OneWay}"
                                       HorizontalAlignment="Right"
                                       Foreground="{StaticResource TextMutedBrush}" />
                        </Grid>

                        <TextBlock Text="Normal Ürün Dağılımı" FontWeight="SemiBold" />
                        <Grid Margin="0,6,0,16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="90" />
                            </Grid.ColumnDefinitions>
                            <ProgressBar Minimum="0"
                                         Maximum="100"
                                         Height="16"
                                         Value="{Binding NormalUrunOrani, Mode=OneWay}" />
                            <TextBlock Grid.Column="1"
                                       Text="{Binding NormalUrunOraniMetni, Mode=OneWay}"
                                       HorizontalAlignment="Right"
                                       Foreground="{StaticResource TextMutedBrush}" />
                        </Grid>

                        <TextBlock Text="Toplam Stok Miktarı" FontWeight="SemiBold" />
                        <Border Background="{StaticResource PrimarySoftBrush}"
                                CornerRadius="12"
                                Padding="18"
                                Margin="0,8,0,0">
                            <TextBlock Text="{Binding ToplamStok}"
                                       FontSize="30"
                                       FontWeight="Bold"
                                       Foreground="{StaticResource PrimaryBrush}" />
                        </Border>
                    </StackPanel>
                </Border>

                <Border Grid.Column="2" Style="{StaticResource CardBorderStyle}">
                    <StackPanel>
                        <TextBlock Text="İşlem Paneli"
                                   FontSize="22"
                                   FontWeight="Bold"
                                   Foreground="{StaticResource TextDarkBrush}" />
                        <TextBlock Text="Rapor kartlarını ve görsel göstergeleri güncelleyin."
                                   Margin="0,6,0,18"
                                   TextWrapping="Wrap"
                                   Foreground="{StaticResource TextMutedBrush}" />
                        <Button Content="Raporları Getir / Yenile"
                                Style="{StaticResource PrimaryButtonStyle}"
                                Command="{Binding YenileCommand}" />
                        <TextBlock Text="{Binding DurumMesaji}"
                                   Margin="0,18,0,4"
                                   FontWeight="SemiBold"
                                   Foreground="{StaticResource TextDarkBrush}"
                                   TextWrapping="Wrap" />
                        <TextBlock Text="{Binding SonGuncelleme}"
                                   Foreground="{StaticResource TextMutedBrush}"
                                   TextWrapping="Wrap" />
                    </StackPanel>
                </Border>
            </Grid>
        </StackPanel>
    </ScrollViewer>
</UserControl>
