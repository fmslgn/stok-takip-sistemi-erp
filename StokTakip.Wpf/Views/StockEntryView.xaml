<UserControl x:Class="StokTakip.Wpf.Views.StockEntryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="380" />
            <ColumnDefinition Width="16" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Border Style="{StaticResource CardBorderStyle}">
            <StackPanel>
                <TextBlock Text="Stok Giriş" FontSize="22" FontWeight="Bold" Foreground="{StaticResource TextDarkBrush}" />
                <TextBlock Text="Depoya giren ürün miktarlarını kaydedin."
                           Margin="0,6,0,18"
                           Foreground="{StaticResource TextMutedBrush}" />

                <TextBlock Text="Ürün Seçimi" FontWeight="SemiBold" />
                <ComboBox x:Name="CmbUrun"
                          Margin="0,4,0,12"
                          ItemsSource="{Binding Urunler}"
                          DisplayMemberPath="UrunAdi" />

                <TextBlock Text="Giriş Miktarı" FontWeight="SemiBold" />
                <TextBox x:Name="TxtMiktar" Margin="0,4,0,12" />

                <TextBlock Text="Açıklama" FontWeight="SemiBold" />
                <TextBox x:Name="TxtAciklama"
                         Margin="0,4,0,12"
                         Height="80"
                         TextWrapping="Wrap"
                         AcceptsReturn="True"
                         VerticalContentAlignment="Top" />

                <TextBlock Text="Tarih" FontWeight="SemiBold" />
                <DatePicker x:Name="DpTarih" Margin="0,4,0,18" />

                <Button Content="Stok Girişi Kaydet"
                        Style="{StaticResource PrimaryButtonStyle}"
                        Click="BtnKaydet_Click" />
                <Button Content="Temizle"
                        Margin="0,10,0,0"
                        Style="{StaticResource SecondaryButtonStyle}"
                        Click="BtnTemizle_Click" />
            </StackPanel>
        </Border>

        <Border Grid.Column="2" Style="{StaticResource CardBorderStyle}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <TextBlock Text="Stok Giriş Hareketleri" FontSize="22" FontWeight="Bold" Foreground="{StaticResource TextDarkBrush}" />
                <DataGrid Grid.Row="1"
                          Margin="0,16,0,0"
                          ItemsSource="{Binding StokGirisleri}"
                          AutoGenerateColumns="False"
                          CanUserAddRows="False"
                          IsReadOnly="True">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="ID" Binding="{Binding Id}" Width="60" />
                        <DataGridTextColumn Header="Ürün ID" Binding="{Binding UrunId}" Width="90" />
                        <DataGridTextColumn Header="Miktar" Binding="{Binding Miktar}" Width="100" />
                        <DataGridTextColumn Header="Açıklama" Binding="{Binding Aciklama}" Width="*" />
                        <DataGridTextColumn Header="Giriş Tarihi" Binding="{Binding GirisTarihi}" Width="170" />
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>
        </Border>
    </Grid>
</UserControl>
