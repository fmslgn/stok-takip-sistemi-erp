<UserControl x:Class="StokTakip.Wpf.Views.StockExitView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:helpers="clr-namespace:StokTakip.Wpf.Helpers">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="380" />
            <ColumnDefinition Width="16" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Border Style="{StaticResource CardBorderStyle}">
            <StackPanel>
                <TextBlock Text="Stok Çıkış" Style="{StaticResource SectionTitleTextStyle}" />
                <TextBlock Text="Depodan çıkan ürün miktarlarını kaydedin."
                           Margin="0,6,0,16"
                           FontSize="13"
                           Foreground="{StaticResource TextMutedBrush}" />

                <TextBlock Text="Ürün Seçimi" Style="{StaticResource FormFieldLabelStyle}" />
                <ComboBox x:Name="CmbUrun"
                          Margin="0,0,0,12"
                          ItemsSource="{Binding Urunler}"
                          DisplayMemberPath="UrunAdi"
                          helpers:ComboBoxPlaceholderHelper.Text="Ürün seçiniz" />

                <TextBlock Text="Çıkış Miktarı" Style="{StaticResource FormFieldLabelStyle}" />
                <TextBox x:Name="TxtMiktar" Margin="0,0,0,12" />

                <TextBlock Text="Açıklama" Style="{StaticResource FormFieldLabelStyle}" />
                <TextBox x:Name="TxtAciklama"
                         Margin="0,0,0,12"
                         Height="80"
                         TextWrapping="Wrap"
                         AcceptsReturn="True"
                         VerticalContentAlignment="Top" />

                <TextBlock Text="Tarih" Style="{StaticResource FormFieldLabelStyle}" />
                <DatePicker x:Name="DpTarih" Margin="0,0,0,16" />

                <Button Content="Stok Çıkışı Kaydet"
                        MinHeight="38"
                        Style="{StaticResource PrimaryButtonStyle}"
                        Click="BtnKaydet_Click" />
                <Button Content="Temizle"
                        Margin="0,10,0,0"
                        MinHeight="36"
                        Style="{StaticResource SecondaryButtonStyle}"
                        Click="BtnTemizle_Click" />
            </StackPanel>
        </Border>

        <Border Grid.Column="2" Style="{StaticResource CardBorderStyle}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Grid Grid.Row="0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="Stok Çıkış Hareketleri"
                               Style="{StaticResource SectionTitleTextStyle}"
                               VerticalAlignment="Center" />
                    <Button Grid.Column="1"
                            Content="PDF Kaydet"
                            MinWidth="112"
                            VerticalAlignment="Center"
                            Style="{StaticResource PrimaryButtonStyle}"
                            Click="BtnStokCikisHareketleriPdfKaydet_Click" />
                </Grid>
                <DataGrid Grid.Row="1"
                          Margin="0,14,0,0"
                          ItemsSource="{Binding StokCikislari}"
                          AutoGenerateColumns="False"
                          CanUserAddRows="False"
                          IsReadOnly="True">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="ID" Binding="{Binding Id}" Width="48" />
                        <DataGridTextColumn Header="Ürün ID" Binding="{Binding UrunId}" Width="72" />
                        <DataGridTextColumn Header="Miktar" Binding="{Binding Miktar}" Width="80" />
                        <DataGridTextColumn Header="Açıklama" Binding="{Binding Aciklama}" Width="*" MinWidth="80" />
                        <DataGridTextColumn Header="Çıkış Tarihi" Binding="{Binding CikisTarihi}" Width="150" />
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>
        </Border>
    </Grid>
</UserControl>
