<UserControl x:Class="StokTakip.Wpf.Views.StorageAssistantView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="360" />
            <ColumnDefinition Width="16" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Border Style="{StaticResource CardBorderStyle}">
            <StackPanel>
                <TextBlock Text="Saklama Asistanı" FontSize="24" FontWeight="Bold" Foreground="{StaticResource TextDarkBrush}" />
                <TextBlock Text="Ürün saklama koşulları hakkında soru sorabilirsiniz."
                           Margin="0,6,0,18"
                           TextWrapping="Wrap"
                           Foreground="{StaticResource TextMutedBrush}" />

                <TextBlock Text="Ürün Adı" FontWeight="SemiBold" />
                <TextBox x:Name="TxtUrunAdi" Margin="0,4,0,12" />

                <TextBlock Text="Kategori" FontWeight="SemiBold" />
                <TextBox x:Name="TxtKategori" Margin="0,4,0,12" />

                <TextBlock Text="Barkod" FontWeight="SemiBold" />
                <TextBox x:Name="TxtBarkod" Margin="0,4,0,18" />

                <Button Content="Öneri Al"
                        Style="{StaticResource PrimaryButtonStyle}"
                        Click="BtnOneriAl_Click" />
                <Button Content="Temizle"
                        Margin="0,10,0,0"
                        Style="{StaticResource SecondaryButtonStyle}"
                        Click="BtnTemizle_Click" />
            </StackPanel>
        </Border>

        <Border Grid.Column="2" Style="{StaticResource CardBorderStyle}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <TextBlock Text="Chat Geçmişi" FontSize="22" FontWeight="Bold" Foreground="{StaticResource TextDarkBrush}" />

                <TextBox x:Name="TxtChatGecmisi"
                         Grid.Row="1"
                         Margin="0,16,0,14"
                         Height="420"
                         TextWrapping="Wrap"
                         AcceptsReturn="True"
                         VerticalScrollBarVisibility="Auto"
                         IsReadOnly="True"
                         VerticalContentAlignment="Top" />

                <Grid Grid.Row="2">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="12" />
                        <ColumnDefinition Width="150" />
                    </Grid.ColumnDefinitions>

                    <TextBox x:Name="TxtKullaniciMesaji"
                             Height="42"
                             VerticalContentAlignment="Center" />
                    <Button Grid.Column="2"
                            Content="Gönder"
                            Style="{StaticResource PrimaryButtonStyle}"
                            Click="BtnGonder_Click" />
                </Grid>
            </Grid>
        </Border>
    </Grid>
</UserControl>
