<UserControl x:Class="StokTakip.Wpf.Views.UserManagementView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:helpers="clr-namespace:StokTakip.Wpf.Helpers">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="380" />
            <ColumnDefinition Width="16" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Border Style="{StaticResource CardBorderStyle}">
            <StackPanel>
                <TextBlock Text="Kullanıcı Yönetimi" Style="{StaticResource SectionTitleTextStyle}" />
                <TextBlock Text="Sistem kullanıcılarını ve rollerini yönetin."
                           Margin="0,6,0,16"
                           FontSize="13"
                           TextWrapping="Wrap"
                           Foreground="{StaticResource TextMutedBrush}" />

                <TextBlock Text="Kullanıcı Adı" Style="{StaticResource FormFieldLabelStyle}" />
                <TextBox Text="{Binding KullaniciAdi, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,12" />

                <TextBlock Text="Ad Soyad" Style="{StaticResource FormFieldLabelStyle}" />
                <TextBox Text="{Binding AdSoyad, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,12" />

                <TextBlock Text="Şifre" Style="{StaticResource FormFieldLabelStyle}" />
                <PasswordBox x:Name="PwdSifre"
                             Margin="0,0,0,12"
                             PasswordChanged="PwdSifre_PasswordChanged" />

                <TextBlock Text="Rol" Style="{StaticResource FormFieldLabelStyle}" />
                <ComboBox Margin="0,0,0,12"
                          ItemsSource="{Binding Roller}"
                          SelectedItem="{Binding Rol, Mode=TwoWay}"
                          helpers:ComboBoxPlaceholderHelper.Text="Rol seçiniz" />

                <CheckBox Content="Aktif mi?"
                          IsChecked="{Binding AktifMi, Mode=TwoWay}"
                          Margin="0,4,0,16" />

                <UniformGrid Columns="2">
                    <Button Content="Ekle" Margin="0,0,8,8" Style="{StaticResource PrimaryButtonStyle}" Command="{Binding EkleCommand}" />
                    <Button Content="Güncelle" Margin="0,0,0,8" Style="{StaticResource SecondaryButtonStyle}" Command="{Binding GuncelleCommand}" />
                    <Button Content="Sil" Margin="0,0,8,0" Style="{StaticResource DangerSecondaryButtonStyle}" Command="{Binding SilCommand}" />
                    <Button Content="Temizle" Style="{StaticResource SecondaryButtonStyle}" Command="{Binding TemizleCommand}" />
                </UniformGrid>

                <TextBlock Text="{Binding DurumMesaji}"
                           Margin="0,12,0,0"
                           FontSize="13"
                           Foreground="{StaticResource TextMutedBrush}"
                           TextWrapping="Wrap" />
            </StackPanel>
        </Border>

        <Border Grid.Column="2" Style="{StaticResource CardBorderStyle}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Grid Grid.Row="0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="Kullanıcı Listesi"
                               Style="{StaticResource SectionTitleTextStyle}"
                               VerticalAlignment="Center" />
                    <Button Grid.Column="1"
                            Content="Listele / Yenile"
                            Margin="0,0,8,0"
                            MinWidth="120"
                            VerticalAlignment="Center"
                            Style="{StaticResource SecondaryButtonStyle}"
                            Command="{Binding ListeYenileCommand}" />
                    <Button Grid.Column="2"
                            Content="PDF Kaydet"
                            MinWidth="112"
                            VerticalAlignment="Center"
                            Style="{StaticResource PrimaryButtonStyle}"
                            Click="BtnKullaniciListesiPdfKaydet_Click" />
                </Grid>
                <DataGrid Grid.Row="1"
                          Margin="0,14,0,0"
                          ItemsSource="{Binding Kullanicilar}"
                          SelectedItem="{Binding SeciliKullanici, Mode=TwoWay}"
                          AutoGenerateColumns="False"
                          CanUserAddRows="False"
                          IsReadOnly="True">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="ID" Binding="{Binding Id}" Width="52" />
                        <DataGridTextColumn Header="Kullanıcı Adı" Binding="{Binding KullaniciAdi}" Width="130" />
                        <DataGridTextColumn Header="Ad Soyad" Binding="{Binding AdSoyad}" Width="*" MinWidth="120" />
                        <DataGridTextColumn Header="Rol" Binding="{Binding Rol}" Width="100" />
                        <DataGridCheckBoxColumn Header="Aktif" Binding="{Binding AktifMi}" Width="64" />
                        <DataGridTextColumn Header="Oluşturma Tarihi" Binding="{Binding OlusturmaTarihi}" Width="150" />
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>
        </Border>
    </Grid>
</UserControl>
